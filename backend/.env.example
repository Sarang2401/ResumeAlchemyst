# ResumeAlchemyst Backend -- Environment Variables
# Copy this file to .env and fill in your values.
# Only the keys for the provider you pick are required.

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Options: "groq" | "openai" | "anthropic" | "gemini" | "ollama"
LLM_PROVIDER=groq

# Groq (recommended -- free tier, very fast)
# Get a key from https://console.groq.com
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI (optional)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini

# Anthropic Claude (optional)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5

# Google Gemini (optional)
# Get a key from https://aistudio.google.com
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-2.0-flash

# Ollama local (no API key needed, requires Ollama running on port 11434)
OLLAMA_MODEL=llama3

# ── LLM Settings ──────────────────────────────────────────────────────────────
LLM_MAX_TOKENS=1024

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8000
LOG_LEVEL=INFO
